  "sequenceRewards": {
    "correctSequence": {
      "description": "Rewards for performing actions in the correct sequence",
      "stepCompletion": {
        "baseReward": 5.0,
        "description": "Reward for completing each step in sequence"
      },
      "skillLearning": {
