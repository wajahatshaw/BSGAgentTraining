        "description": "Reward for successfully learning a skill at a tool",
        "multiplier": 1.0
      },
      "sequenceCompletion": {
        "fullSequenceBonus": 50.0,
        "description": "Bonus reward for completing entire sequence in correct order"
      },
      "preconditionSatisfaction": {
        "reward": 10.0,
        "description": "Reward for satisfying all preconditions before action"
      }
    },
    "incorrectSequence": {
      "description": "Penalties and neutral feedback for incorrect sequences",
      "wrongOrder": {
        "penalty": -15.0,
        "description": "Penalty for performing actions out of sequence order"
      },
      "missingPrecondition": {
        "penalty": -10.0,
        "description": "Penalty for attempting action without required preconditions"
      },
      "wrongTool": {
        "penalty": -20.0,
        "description": "Penalty for interacting with wrong tool in sequence"
      },
      "skippedStep": {
        "penalty": -25.0,
        "description": "Penalty for skipping a required step in sequence"
      },
      "neutralFeedback": {
        "reward": 0.0,
        "description": "Neutral feedback (no reward/penalty) for actions that don't match sequence but aren't harmful"
      }
    },
    "validationRules": {
      "strictOrder": true,
      "requirePreconditions": true,
      "allowParallelActions": false,
      "sequenceResetOnError": false
    }
  },
  "ml_training_config": {
    "enabled": true,
    "observation_space_size": 25,
